# Copy to .env.local and fill in with values from your Supabase project
# (Supabase dashboard → Project Settings → API)

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# service_role key. Server-side only — never prefix this with NEXT_PUBLIC_,
# it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# Shared passphrase needed to create, edit or delete visits. Anyone can still
# read the map. If this is empty, editing is blocked for everyone.
APP_PASSWORD=
