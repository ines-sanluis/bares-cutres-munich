# Copy to .env.local and fill in with values from your Supabase project
# (Supabase dashboard → Project Settings → API)

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# service_role key (newer projects call it a "secret key", sb_secret_…).
# NOT the anon / publishable key: that one is subject to row level security, and
# since the schema enables RLS with no policies you would get
# "new row violates row-level security policy" on every save.
# Server-side only — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared passphrase needed to create, edit or delete visits. Anyone can still
# read the map. If this is empty, editing is blocked for everyone.
APP_PASSWORD=
